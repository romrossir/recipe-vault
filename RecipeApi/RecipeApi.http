@RecipeApi_HostAddress = http://localhost:5015

### ========================================
### GET all recipes
### ========================================

GET {{RecipeApi_HostAddress}}/api/recipes
Accept: application/json


### ========================================
### GET recipe by ID
### ========================================

GET {{RecipeApi_HostAddress}}/api/recipes/1
Accept: application/json


### ========================================
### GET non-existing recipe
### Expected: 404 Not Found
### ========================================

GET {{RecipeApi_HostAddress}}/api/recipes/999
Accept: application/json


### ========================================
### CREATE recipe
### Expected: 201 Created
### ========================================

POST {{RecipeApi_HostAddress}}/api/recipes
Content-Type: application/json

{
  "title": "Mini crêpes",
  "ingredients": [
    {
      "name": "farine",
      "quantity": "250",
      "unit": "g"
    },
    {
      "name": "œufs",
      "quantity": "3",
      "unit": null
    },
    {
      "name": "lait",
      "quantity": "50",
      "unit": "cl"
    }
  ],
  "steps": [
    "Mélanger la farine et les œufs.",
    "Ajouter progressivement le lait.",
    "Laisser reposer la pâte.",
    "Faire cuire les crêpes dans une poêle chaude."
  ]
}


### ========================================
### CREATE another recipe
### Expected: 201 Created
### ========================================

POST {{RecipeApi_HostAddress}}/api/recipes
Content-Type: application/json

{
  "title": "Gâteau au chocolat",
  "ingredients": [
    {
      "name": "chocolat noir",
      "quantity": "200",
      "unit": "g"
    },
    {
      "name": "beurre",
      "quantity": "150",
      "unit": "g"
    },
    {
      "name": "œufs",
      "quantity": "4",
      "unit": null
    }
  ],
  "steps": [
    "Faire fondre le chocolat avec le beurre.",
    "Ajouter les œufs.",
    "Verser dans un moule.",
    "Cuire au four."
  ]
}


### ========================================
### CREATE invalid recipe
### Expected: 400 Bad Request
### ========================================

POST {{RecipeApi_HostAddress}}/api/recipes
Content-Type: application/json

{
  "title": "",
  "ingredients": [],
  "steps": []
}


### ========================================
### UPDATE recipe
### Expected: 204 No Content
### ========================================

PUT {{RecipeApi_HostAddress}}/api/recipes/1
Content-Type: application/json

{
  "title": "Mini crêpes au chocolat",
  "ingredients": [
    {
      "name": "farine",
      "quantity": "250",
      "unit": "g"
    },
    {
      "name": "œufs",
      "quantity": "3",
      "unit": null
    },
    {
      "name": "lait",
      "quantity": "50",
      "unit": "cl"
    },
    {
      "name": "chocolat noir",
      "quantity": "100",
      "unit": "g"
    }
  ],
  "steps": [
    "Mélanger la farine et les œufs.",
    "Ajouter progressivement le lait.",
    "Ajouter le chocolat fondu.",
    "Faire cuire les crêpes."
  ]
}


### ========================================
### UPDATE non-existing recipe
### Expected: 404 Not Found
### ========================================

PUT {{RecipeApi_HostAddress}}/api/recipes/999
Content-Type: application/json

{
  "title": "Recipe inexistante",
  "ingredients": [],
  "steps": []
}


### ========================================
### DELETE recipe
### Expected: 204 No Content
### ========================================

DELETE {{RecipeApi_HostAddress}}/api/recipes/1


### ========================================
### DELETE non-existing recipe
### Expected: 404 Not Found
### ========================================

DELETE {{RecipeApi_HostAddress}}/api/recipes/999


### ========================================
### Verify recipe was deleted
### Expected: 404 Not Found
### ========================================

GET {{RecipeApi_HostAddress}}/api/recipes/1
Accept: application/json

### ========================================
POST {{RecipeApi_HostAddress}}/api/recipes/embedding-test
Content-Type: application/json

"dessert au chocolat rapide"

### Semantic search

GET {{RecipeApi_HostAddress}}/api/recipes/search?q=Je%20cherche%20une%20recette%20de%20pavlova&limit=50
Accept: application/json

### ========================================
### GET recipe by ID
### ========================================

GET {{RecipeApi_HostAddress}}/api/recipes/6ababdb1f4719fbba2f0ce61
Accept: application/json

### RAG - dessert au chocolat
POST {{RecipeApi_HostAddress}}/api/recipes/ask
Content-Type: application/json
Accept: application/json

{
  "question": "Je cherche une recette de pavlova"
}

### RAG - goûter aux fruits
POST {{RecipeApi_HostAddress}}/api/recipes/ask
Content-Type: application/json
Accept: application/json

{
  "question": "Je cherche quelque chose aux fruits pour le goûter"
}

### RAG - légumes
POST {{RecipeApi_HostAddress}}/api/recipes/ask
Content-Type: application/json
Accept: application/json

{
  "question": "Je cherche une recette de cheesecake"
}

### ========================================
### INGEST (vision) - default mode, uses vision model
### ========================================

POST {{RecipeApi_HostAddress}}/api/recipes/ingest
Content-Type: multipart/form-data; boundary=----Boundary

------Boundary
Content-Disposition: form-data; name="file"; filename="fdp_74.pdf"
Content-Type: application/pdf

< C:\workspace\recipe-images\fdp_74.pdf
------Boundary--

### ========================================
### INGEST (vision) - default mode, uses vision model
### ========================================

POST {{RecipeApi_HostAddress}}/api/recipes/ingest?page=1
Content-Type: multipart/form-data; boundary=----Boundary

------Boundary
Content-Disposition: form-data; name="file"; filename="financiers.png"
Content-Type: image/png

< C:\workspace\recipe-images\financiers.png
------Boundary--

### ========================================
### INGEST (ocr) - uses OCR service at :8080
### ========================================

POST {{RecipeApi_HostAddress}}/api/recipes/ingest?mode=ocr&page=1
Content-Type: multipart/form-data; boundary=----Boundary

------Boundary
Content-Disposition: form-data; name="file"; filename="financiers.png"
Content-Type: image/png

< C:\workspace\recipe-images\financiers.png
------Boundary--

### ========================================
### INGEST (manual) - source file + JSON recipes, no LLM/OCR
### ========================================

POST {{RecipeApi_HostAddress}}/api/recipes/ingest/manual
Content-Type: multipart/form-data; boundary=----Boundary

------Boundary
Content-Disposition: form-data; name="file"; filename="financiers.png"
Content-Type: image/png

< C:\workspace\recipe-images\financiers.png
------Boundary
Content-Disposition: form-data; name="recipes"

[
  {
    "title": "Les financiers",
    "ingredients": [
      { "name": "de beurre", "quantity": "100", "unit": "g" },
      { "name": "de farine T45", "quantity": "60", "unit": "g" },
      { "name": "de poudre d'amande", "quantity": "80", "unit": "g" },
      { "name": "de sucre", "quantity": "100", "unit": "g" },
      { "name": "de fleur de sel", "quantity": "5", "unit": "g" },
      { "name": "blancs d'oeufs", "quantity": "4", "unit": null }
    ],
    "steps": [
      "Réalisez un beurre noisette puis laissez-le refroidir jusqu'à environ 40 °C. Mélangez la farine, la poudre d'amande, le sucre et la fleur de sel. Ajoutez les blancs d'œufs puis incorporez le beurre noisette jusqu'à obtenir une pâte lisse. Graissez les moules, remplissez-les aux trois quarts, lissez la surface puis tapotez légèrement les moules.",
      "Faites cuire environ 10 minutes à 200 °C en chaleur tournante puis laissez refroidir avant de démouler."
    ],
    "sourcePages": [1]
  },
  {
    "title": "Les muffins chocolat blanc et myrtilles",
    "ingredients": [
      { "name": "de myrtilles", "quantity": "200", "unit": "g" },
      { "name": "de farine T55", "quantity": "210", "unit": "g" },
      { "name": "de fleur de sel", "quantity": "3", "unit": "g" },
      { "name": "de levure chimique", "quantity": "11", "unit": "g" },
      { "name": "oeufs", "quantity": "2", "unit": null },
      { "name": "de sucre brun", "quantity": "100", "unit": "g" },
      { "name": "de yaourt grec", "quantity": "230", "unit": "g" },
      { "name": "d'huile de pépins de raisin", "quantity": "35", "unit": "g" },
      { "name": "de chocolat blanc", "quantity": "200", "unit": "g" }
    ],
    "steps": [
      "Placez les myrtilles au congélateur environ 2 heures avant de commencer. Mélangez la farine, la fleur de sel et la levure. Fouettez les œufs avec le sucre pendant 1 minute. Ajoutez le yaourt puis l'huile. Incorporez les poudres et mélangez énergiquement. Ajoutez le chocolat blanc concassé et les myrtilles bien froides, puis mélangez délicatement.",
      "Répartissez la pâte dans les moules graissés ou chemisés de caissettes en les remplissant aux deux tiers. Faites cuire 10 minutes à 200-210 °C, puis poursuivez la cuisson 10 minutes à 180 °C. Éteignez le four et laissez reposer 5 minutes sans ouvrir la porte."
    ],
    "sourcePages": [1]
  }
]
------Boundary--

### ========================================
### SOURCE FILES - upload
### ========================================

POST {{RecipeApi_HostAddress}}/api/sources
Content-Type: multipart/form-data; boundary=----Boundary

------Boundary
Content-Disposition: form-data; name="file"; filename="magazine.pdf"
Content-Type: application/pdf

< ./test-file.pdf
------Boundary--

### ========================================
### SOURCE FILES - list all
### ========================================

GET {{RecipeApi_HostAddress}}/api/sources
Accept: application/json

### ========================================
### SOURCE FILES - get by ID
### ========================================

GET {{RecipeApi_HostAddress}}/api/sources/1
Accept: application/json

### ========================================
### SOURCE FILES - download content
### ========================================

GET {{RecipeApi_HostAddress}}/api/sources/1/content

### ========================================
### SOURCE FILES - delete
### ========================================

DELETE {{RecipeApi_HostAddress}}/api/sources/1

### Search - titre exact
GET {{RecipeApi_HostAddress}}/api/recipes/search?q=Je%20cherche%20une%20recette%20de%20cheesecake&limit=10
Accept: application/json